import torch
import boto3
import os

def save_model_to_s3(model, optimizer, epoch, s3_bucket, s3_key, local_path="checkpoint.pth"):
    # Save locally
    torch.save({
        'epoch': epoch,
        'model_state': model.state_dict(),
        'optimizer_state': optimizer.state_dict()
    }, local_path)
    
    # Upload to S3
    s3 = boto3.client('s3')
    s3.upload_file(local_path, s3_bucket, s3_key)
    print(f"Saved checkpoint to s3://{s3_bucket}/{s3_key}")

def load_model_from_s3(model, optimizer, s3_bucket, s3_key, local_path="checkpoint.pth"):
    # Download from S3
    s3 = boto3.client('s3')
    s3.download_file(s3_bucket, s3_key, local_path)
    
    checkpoint = torch.load(local_path, map_location=torch.device('cpu'))
    model.load_state_dict(checkpoint['model_state'])
    optimizer.load_state_dict(checkpoint['optimizer_state'])
    print(f"Loaded checkpoint from s3://{s3_bucket}/{s3_key}, epoch {checkpoint['epoch']}")
    return checkpoint['epoch']



import torch.nn as nn
import torch.optim as optim

class Generator(nn.Module):
    def __init__(self, latent_dim, feature_dim):
        super().__init__()
        self.model = nn.Sequential(
            nn.Linear(latent_dim, 64),
            nn.ReLU(),
            nn.Linear(64, 128),
            nn.ReLU(),
            nn.Linear(128, feature_dim),
            nn.Sigmoid()
        )
    def forward(self, z):
        return self.model(z)

class Discriminator(nn.Module):
    def __init__(self, feature_dim):
        super().__init__()
        self.model = nn.Sequential(
            nn.Linear(feature_dim, 128),
            nn.LeakyReLU(0.2),
            nn.Linear(128, 64),
            nn.LeakyReLU(0.2),
            nn.Linear(64, 1),
            nn.Sigmoid()
        )
    def forward(self, x):
        return self.model(x)

def train_vanilla_gan(dataloader, latent_dim, feature_dim, device, s3_bucket, s3_prefix):
    G = Generator(latent_dim, feature_dim).to(device)
    D = Discriminator(feature_dim).to(device)

    criterion = nn.BCELoss()
    optimizer_G = optim.Adam(G.parameters(), lr=2e-4)
    optimizer_D = optim.Adam(D.parameters(), lr=2e-4)

    epochs = 50
    for epoch in range(epochs):
        for real_batch, in dataloader:
            real_batch = real_batch.to(device)
            batch_size = real_batch.size(0)

            # Train Discriminator
            optimizer_D.zero_grad()
            real_labels = torch.ones((batch_size, 1), device=device)
            fake_labels = torch.zeros((batch_size, 1), device=device)

            output_real = D(real_batch)
            loss_real = criterion(output_real, real_labels)

            z = torch.randn(batch_size, latent_dim, device=device)
            fake_data = G(z)
            output_fake = D(fake_data.detach())
            loss_fake = criterion(output_fake, fake_labels)

            loss_D = loss_real + loss_fake
            loss_D.backward()
            optimizer_D.step()

            # Train Generator
            optimizer_G.zero_grad()
            z = torch.randn(batch_size, latent_dim, device=device)
            fake_data = G(z)
            output = D(fake_data)
            loss_G = criterion(output, real_labels)
            loss_G.backward()
            optimizer_G.step()

        if (epoch + 1) % 10 == 0:
            print(f"[Vanilla GAN] Epoch [{epoch+1}/{epochs}] Loss_D: {loss_D.item():.4f} Loss_G: {loss_G.item():.4f}")
            save_model_to_s3(G, optimizer_G, epoch+1, s3_bucket, f"{s3_prefix}/vanilla_G_epoch{epoch+1}.pth")
            save_model_to_s3(D, optimizer_D, epoch+1, s3_bucket, f"{s3_prefix}/vanilla_D_epoch{epoch+1}.pth")




class Critic(nn.Module):
    def __init__(self, feature_dim):
        super().__init__()
        self.model = nn.Sequential(
            nn.Linear(feature_dim, 128),
            nn.LeakyReLU(0.2),
            nn.Linear(128, 64),
            nn.LeakyReLU(0.2),
            nn.Linear(64, 1)
        )
    def forward(self, x):
        return self.model(x)

def gradient_penalty(critic, real_data, fake_data, device):
    batch_size = real_data.size(0)
    epsilon = torch.rand(batch_size, 1, device=device)
    epsilon = epsilon.expand_as(real_data)
    interpolated = epsilon * real_data + (1 - epsilon) * fake_data
    interpolated.requires_grad_(True)
    mixed_scores = critic(interpolated)
    grad_outputs = torch.ones_like(mixed_scores, device=device)
    gradients = torch.autograd.grad(
        outputs=mixed_scores,
        inputs=interpolated,
        grad_outputs=grad_outputs,
        create_graph=True,
        retain_graph=True
    )[0]
    gradients = gradients.view(batch_size, -1)
    grad_norm = gradients.norm(2, dim=1)
    return ((grad_norm - 1) ** 2).mean()

def train_wgan_gp(dataloader, latent_dim, feature_dim, device, s3_bucket, s3_prefix):
    G = Generator(latent_dim, feature_dim).to(device)
    C = Critic(feature_dim).to(device)

    optimizer_G = optim.Adam(G.parameters(), lr=1e-4, betas=(0.0, 0.9))
    optimizer_C = optim.Adam(C.parameters(), lr=1e-4, betas=(0.0, 0.9))

    lambda_gp = 10
    critic_iter = 5
    epochs = 50

    for epoch in range(epochs):
        for i, (real_batch,) in enumerate(dataloader):
            real_batch = real_batch.to(device)
            batch_size = real_batch.size(0)

            for _ in range(critic_iter):
                z = torch.randn(batch_size, latent_dim, device=device)
                fake_data = G(z)
                crit_real = C(real_batch).mean()
                crit_fake = C(fake_data.detach()).mean()
                gp = gradient_penalty(C, real_batch, fake_data, device)
                loss_C = -(crit_real - crit_fake) + lambda_gp * gp
                optimizer_C.zero_grad()
                loss_C.backward()
                optimizer_C.step()

            z = torch.randn(batch_size, latent_dim, device=device)
            fake_data = G(z)
            loss_G = -C(fake_data).mean()
            optimizer_G.zero_grad()
            loss_G.backward()
            optimizer_G.step()

        if (epoch + 1) % 10 == 0:
            print(f"[WGAN-GP] Epoch [{epoch+1}/{epochs}] Loss_C: {loss_C.item():.4f} Loss_G: {loss_G.item():.4f}")
            save_model_to_s3(G, optimizer_G, epoch+1, s3_bucket, f"{s3_prefix}/wgan_G_epoch{epoch+1}.pth")
            save_model_to_s3(C, optimizer_C, epoch+1, s3_bucket, f"{s3_prefix}/wgan_C_epoch{epoch+1}.pth")



